<%- include('partials/header'); -%>

<h1><%= t('score.return.reminder') %></h1>

<% 
  let errorStyle; 
  let errorText;
 if (error) { 
  errorStyle = "display: block"
  errorText = error;
 } else { 
  errorStyle = "display: none"
  errorText = "";
 } 
%>
<div class="w3-panel w3-red divError" style="<%= errorStyle %>">
  <p class="pError"><%= errorText %></p>
</div>

<% 
  let successStyle; 
  let successText;
 if (success) { 
  successStyle = "display: block"
  successText = success;
 } else { 
  successStyle = "display: none"
  successText = "";
 } 
%>
<div class="w3-panel w3-green divSuccess" style="<%= successStyle %>">
  <p class="pSuccess"><%= successText %></p>
</div>

<%- include('partials/reminder-form', {
  action: '/admin/return-reminder',
  selectLabel: t('score.return.reminder.select'),
  sendLabel: t('score.return.reminder.send'),
}); -%>

<%- include('partials/footer'); -%>
