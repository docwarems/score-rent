<%
  // Shared markup for the early- and return-reminder pages.
  // Expects: action, selectLabel, sendLabel, signatures, signature, campaign, borrowers, sent
  const selectedSignature = typeof signature !== 'undefined' && signature ? signature : '';
  const selectedCampaign = typeof campaign !== 'undefined' && campaign ? campaign : '';
  const resultBorrowers = typeof borrowers !== 'undefined' && borrowers ? borrowers : null;
  const wasSent = typeof sent !== 'undefined' && sent;
%>

<form action="<%= action %>" method="post" id="reminderForm">
  <label><%= selectLabel %></label>
  <select name="signature" id="signatureSelect" class="w3-select w3-border" required>
    <option value="" disabled <%= selectedSignature ? '' : 'selected' %>><%= t('choose') %></option>
    <% signatures.forEach(signature => { %>
      <% if (signature.id !== 'ALL') { %>
        <option value="<%= signature.id %>" <%= signature.id === selectedSignature ? 'selected' : '' %>><%= signature.name %> (<%= signature.id %>)</option>
      <% } %>
    <% }); %>
  </select>
  <p></p>
  <label><%= t('score.reminder.campaign') %></label>
  <input type="text" name="campaign" id="campaignInput" class="w3-input w3-border" required
         maxlength="100" placeholder="<%= t('score.reminder.campaign.placeholder') %>"
         value="<%= selectedCampaign %>">
  <p></p>
  <button class="w3-button w3-black" type="submit" id="submitButton"><%= sendLabel %></button>
</form>

<div id="previewArea" style="margin-top: 20px;"></div>

<% if (resultBorrowers && resultBorrowers.length > 0) { %>
  <div class="w3-responsive divBorrowers" style="margin-top: 20px;">
    <h3><%= wasSent ? t('score.reminder.sent.title') : t('score.reminder.preview.title') %></h3>
    <table class="w3-table-all">
      <tr>
        <th><%= t('score.reminder.table.name') %></th>
        <th><%= t('score.reminder.table.email') %></th>
        <th><%= t('score.reminder.table.score.id') %></th>
        <th><%= t('score.reminder.table.checkout.date') %></th>
      </tr>
      <% resultBorrowers.forEach(borrower => { %>
      <tr>
        <td><%= borrower.userName %></td>
        <td><%= borrower.userEmail %></td>
        <td><%= borrower.scoreId %></td>
        <td><%= borrower.checkoutDate %></td>
      </tr>
      <% }); %>
    </table>
  </div>
<% } %>

<script>
  (function () {
    const i18n = {
      loading: <%- JSON.stringify(t('score.reminder.preview.loading')) %>,
      loadError: <%- JSON.stringify(t('score.reminder.preview.error')) %>,
      empty: <%- JSON.stringify(t('score.reminder.preview.empty')) %>,
      summary: <%- JSON.stringify(t('score.reminder.preview.summary')) %>,
      title: <%- JSON.stringify(t('score.reminder.preview.title')) %>,
      testRecipient: <%- JSON.stringify(t('score.reminder.preview.test.recipient')) %>,
      name: <%- JSON.stringify(t('score.reminder.table.name')) %>,
      email: <%- JSON.stringify(t('score.reminder.table.email')) %>,
      scoreId: <%- JSON.stringify(t('score.reminder.table.score.id')) %>,
      checkoutDate: <%- JSON.stringify(t('score.reminder.table.checkout.date')) %>,
    };

    const select = document.getElementById('signatureSelect');
    const preview = document.getElementById('previewArea');
    const submitButton = document.getElementById('submitButton');
    // The server-rendered list belongs to the previous submit and would be
    // misleading next to a preview of a newly selected score.
    const resultTable = document.querySelector('.divBorrowers');

    const escapeHtml = (value) =>
      String(value == null ? '' : value).replace(/[&<>"']/g, (c) => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
      })[c]);

    const panel = (cssClass, html) =>
      '<div class="w3-panel ' + cssClass + ' w3-border">' + html + '</div>';

    // Guards against an out-of-order response overwriting a newer selection.
    let requestId = 0;

    async function loadBorrowers(signature) {
      if (resultTable) {
        resultTable.style.display = 'none';
      }

      if (!signature) {
        preview.innerHTML = '';
        return;
      }

      const currentRequest = ++requestId;
      preview.innerHTML = panel('w3-pale-blue', '<p>' + escapeHtml(i18n.loading) + '</p>');
      submitButton.disabled = true;

      try {
        const res = await fetch(
          '/admin/reminder-borrowers?signature=' + encodeURIComponent(signature)
        );
        if (!res.ok) {
          throw new Error('Request failed with status ' + res.status);
        }
        const data = await res.json();
        if (currentRequest !== requestId) {
          return;
        }
        render(data);
      } catch (error) {
        if (currentRequest !== requestId) {
          return;
        }
        console.error('Error loading borrowers:', error);
        preview.innerHTML = panel('w3-pale-red', '<p>' + escapeHtml(i18n.loadError) + '</p>');
        submitButton.disabled = false;
      }
    }

    function render(data) {
      const borrowers = data.borrowers || [];

      if (borrowers.length === 0) {
        preview.innerHTML = panel('w3-pale-yellow', '<p>' + escapeHtml(i18n.empty) + '</p>');
        submitButton.disabled = true;
        return;
      }

      const summary = i18n.summary
        .replace('{{count}}', data.recipientCount)
        .replace('{{scores}}', borrowers.length);

      let html = panel('w3-pale-green', '<p><b>' + escapeHtml(summary) + '</b></p>');

      if (data.testRecipient) {
        const warning = i18n.testRecipient.replace('{{email}}', data.testRecipient);
        html += panel('w3-pale-red', '<p>' + escapeHtml(warning) + '</p>');
      }

      html +=
        '<h3>' + escapeHtml(i18n.title) + '</h3>' +
        '<div class="w3-responsive"><table class="w3-table-all"><tr>' +
        '<th>' + escapeHtml(i18n.name) + '</th>' +
        '<th>' + escapeHtml(i18n.email) + '</th>' +
        '<th>' + escapeHtml(i18n.scoreId) + '</th>' +
        '<th>' + escapeHtml(i18n.checkoutDate) + '</th>' +
        '</tr>' +
        borrowers
          .map(
            (b) =>
              '<tr><td>' + escapeHtml(b.userName) +
              '</td><td>' + escapeHtml(b.userEmail) +
              '</td><td>' + escapeHtml(b.scoreId) +
              '</td><td>' + escapeHtml(b.checkoutDate) +
              '</td></tr>'
          )
          .join('') +
        '</table></div>';

      preview.innerHTML = html;
      submitButton.disabled = false;
    }

    select.addEventListener('change', () => loadBorrowers(select.value));
  })();
</script>
